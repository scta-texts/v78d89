      <div xml:id="v78d89-a6alp1"><!-- q28prae -->
        <head xml:id="v78d89-a6alp1-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-a6alp1-d1e103">
          <lb ed="#N" n="62"/>⁋ Questio. xxviii. de dispe
          <lb ed="#N" n="63"/>satione sacramenti confirmationis.
        </p>
        <p xml:id="v78d89-a6alp1-d1e110">
          <lb ed="#N" n="64"/>Onsequeter querit
          <lb ed="#N" n="65"/>tur de dispensatione. Circa quod primo
          que<lb ed="#N" n="66" break="no"/>ritur. quis potest confirmare. Secundo. quis debeat
          <lb ed="#N" n="67"/>confirmari. Tercio. quis debet vel potest
          confir<lb ed="#N" n="68" break="no"/>mandum tenere. Quarto. vtrum debuit christus
          <lb ed="#N" n="69"/>confirmari. Quinto. de tempore confirmationis. Sexto. de loco
          con<cb ed="#N" n="b"/><lb ed="#N" n="70" break="no"/>firmationis. Septimo. de iteratione confirmationis.
        </p>
      </div>
