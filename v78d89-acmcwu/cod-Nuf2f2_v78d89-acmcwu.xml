      <div xml:id="v78d89-acmcwu"><!-- q67prae -->
        <head xml:id="v78d89-acmcwu-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-acmcwu-d1e103">
          <lb ed="#N" n="98"/>⁋ Questio. txvii. de
          coniri<lb ed="#N" n="99" break="no"/>tionis quidditate.
        </p>
        <p xml:id="v78d89-acmcwu-d1e110">
          <lb ed="#N" n="100"/>SEquitur de tibus
          <lb ed="#N" n="101"/>penitentie in specieali. Et primo de contritione. Secundo
          <lb ed="#N" n="102"/>de confessione. Tercio de satisfactione. De
          con<lb ed="#N" n="103" break="no"/>tritione queruntur septem in generali. Primo de ipsa
          <lb ed="#N" n="104"/>quantum ad quidditatem. Secundo quantum ad qualitatem.
          <lb ed="#N" n="105"/>Tercio quantum ad obiectum. Quarto quantum ad effectum. Quinto
          <lb ed="#N" n="106"/>quantum ad ordinem. Sexto quantum ad originem. Septimo quantum ad
          im<lb ed="#N" n="107" break="no"/>pletionem.
        </p>
        <p xml:id="v78d89-acmcwu-d1e130">
          ⁋ Circa quidditatem queruntur hec. Primo. quid sit re. Secundo
          <lb ed="#N" n="108"/>quid sit nomine. Tercio. quid sit diffinitione.
        </p>
      </div>
    </body>
