    <body>
      <div xml:id="v78d89-ad8uyy"><!-- q70prae -->
        <head xml:id="v78d89-ad8uyy-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-ad8uyy-d1e103">
          <pb ed="#N" n="455"/>
          <cb ed="#N" n="a"/>
          <lb ed="#N" n="1"/>⁋ Questio. lxx. de effectu
          <lb ed="#N" n="2"/>contritionis qui est iustificatio impii.
        </p>
        <p xml:id="v78d89-ad8uyy-d1e114">
          <lb ed="#N" n="3"/>SEquitur de effectu
          <lb ed="#N" n="4"/>contritionis. et quia de eius effectibus est
          iusti<lb ed="#N" n="5" break="no"/>ficatio impii. Ad maiorem euidentiam eorum
          <lb ed="#N" n="6"/>que dicuntur primo queritur quid sit
          iustifi<lb ed="#N" n="7" break="no"/>catio impii. Secundo. vtrum contritio efficaciam
          <lb ed="#N" n="8"/>habeat in iustificatione impii. Tercio. vtrum habeat efficaciam
          iusti<lb ed="#N" n="9" break="no"/>ficandi a culpa. Quarto. vtrum habeat efficaciam iustificandi
          <lb ed="#N" n="10"/>a pena de aliis effectibus. videlicet vtrum habeat efficaciam
          pur<lb ed="#N" n="11" break="no"/>gandi a sequelis peccati. et de numero eorum et sufficientia
          <lb ed="#N" n="12"/>et ordine que requiruntur ad iustificationem etc. patebit in
          sequen<lb ed="#N" n="13" break="no"/>tibus.
        </p>
      </div>
    </body>
