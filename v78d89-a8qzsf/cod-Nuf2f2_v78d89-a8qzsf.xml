      <div xml:id="v78d89-a8qzsf"><!-- q43prae -->
        <head xml:id="v78d89-a8qzsf-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-a8qzsf-d1e103">
          <lb ed="#N" n="26"/>Questio. xitum. de
          manduca<lb ed="#N" n="27" break="no"/>tione huius sacramenti in generali.
        </p>
        <p xml:id="v78d89-a8qzsf-d1e110">
          <lb ed="#N" n="28"/>SEquitur de mandum
          <lb ed="#N" n="29"/>catione siue sumptione huius sacramenti. que
          <lb ed="#N" n="30"/>est decima pars huius tractatus. In hac parte
          <lb ed="#N" n="31"/>primo queritur de manducatione in
          genera<lb ed="#N" n="32" break="no"/>lidb. Secundo de manducatione in spieitiali.
        </p>
        <p xml:id="v78d89-a8qzsf-d1e123">
          ⁋ In
          pri<lb ed="#N" n="33" break="no"/>ma parte primo queritur de numero modorum manducandi que
          <lb ed="#N" n="34"/>exprimuntur per manducationem spiritualem et sacramentalem.
          Se<lb ed="#N" n="35" break="no"/>cundo de idemptitate modorum. Tercio pro quanto dicatur
          <lb ed="#N" n="36"/>quis manducare spiritualiter. Quarto pro quanto dicatur quis
          <lb ed="#N" n="37"/>manducare sacramentaliter.
        </p>
      </div>
    </body>
