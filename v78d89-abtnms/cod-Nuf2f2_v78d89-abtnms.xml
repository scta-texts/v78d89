      <div xml:id="v78d89-abtnms"><!-- q61prae -->
        <head xml:id="v78d89-abtnms-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-abtnms-d1e103">
          <cb ed="#N" n="b"/>
          <lb ed="#N" n="68"/>⁋ Quertio. ixi. de vnitace
          <lb ed="#N" n="69"/>penitentie inquantum est sacramentum.
        </p>
        <p xml:id="v78d89-abtnms-d1e112">
          <lb ed="#N" n="70"/>SEquitur de
          bsicca<lb ed="#N" n="71" break="no"/>te huius sacramenti. Circa quod
          qde<lb ed="#N" n="72" break="no"/>runtur plura. Primum est ansit vnum
          <lb ed="#N" n="73"/>sacramentum. Secundum si sit vnum: quo
          <lb ed="#N" n="74"/>genere vnitatis. Tercium est an maior
          <lb ed="#N" n="75"/>vnitas penitentie virtutis: an penitentie sacramenu.
          <lb ed="#N" n="76"/>Quartum est quia questio de nominatione refertur ad
          quellio<lb ed="#N" n="77" break="no"/>nem de vnitate. queritur vtrum debeat denomnari a significa
        </p>
        <p xml:id="v78d89-abtnms-d1e132">
          <lb ed="#N" n="78"/>tione.
        </p>
      </div>
    </body>
