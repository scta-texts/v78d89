    <body>
      <div xml:id="v78d89-aaxtcc"><!-- q54prae -->
        <head xml:id="v78d89-aaxtcc-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-aaxtcc-d1e103">
          <lb ed="#N" n="29"/>⁋ Quertio. iiiii. de penstetu
          <lb ed="#N" n="30"/>inoantum est virtus quid sit.
        </p>
        <p xml:id="v78d89-aaxtcc-d1e110">
          <lb ed="#N" n="31"/>Etermtinato de
          sa<lb ed="#N" n="32" break="no"/>cramento eucharistie sequitur de penitentia
          <lb ed="#N" n="33"/>Et primo inquantum est virtus. Secundo
          in<lb ed="#N" n="34" break="no"/>quantum est gratia. Tercio inquantum est
          sacra<lb ed="#N" n="35" break="no"/>mentum.
        </p>
        <p xml:id="v78d89-aaxtcc-d1e123">
          ⁋ De penitentia virtute queruntur
          <lb ed="#N" n="36"/>hec. Primo de penitentia quantum ad essentiam. Secundo
          quan<lb ed="#N" n="37" break="no"/>tum ad subiectum. Tercio quantum ad ordinem. Quarto quantum
          <lb ed="#N" n="38"/>ad effectum.
        </p>
      </div>
    </body>
