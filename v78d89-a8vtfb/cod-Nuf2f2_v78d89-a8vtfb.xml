      <div xml:id="v78d89-a8vtfb"><!-- q44prae -->
        <head xml:id="v78d89-a8vtfb-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-a8vtfb-d1e103">
          <lb ed="#N" n="41"/>Questio. xliiii. de
          mandu<lb ed="#N" n="42" break="no"/>catione huius sacramenti in speciali.
        </p>
        <p xml:id="v78d89-a8vtfb-d1e110">
          <lb ed="#N" n="43"/>SEquitur de
          mandu<lb ed="#N" n="44" break="no"/>catione corporis in speciali. et primo queritur
          <lb ed="#N" n="45"/>de manducatione facta in cena. secundo de
          <lb ed="#N" n="46"/>manducatione quam frequentat ecclesia.
        </p>
        <p xml:id="v78d89-a8vtfb-d1e121">
          ⁋ De
          <lb ed="#N" n="47"/>manducatione prima. primo queritur. vtrum
          <lb ed="#N" n="48"/>christus sumpsit corpus suum in cena. Secundo dato quod sic. vtrum
          <lb ed="#N" n="49"/>sumpsit illud spiritualiter vel sacramentaliter. Tercio quale
          <lb ed="#N" n="50"/>corpus dedit discipulis. Quarto vtrum corpus suum dedit
          iu<lb ed="#N" n="51" break="no"/>de. Quinto vtrum corpus illud sumptum in cena reseruatum
          <lb ed="#N" n="52"/>in pixide vsque ad mortem christi moreretur. Sextum vtrum
          conse<lb ed="#N" n="53" break="no"/>cratione facta in triduo sepulture: fieret anima cum corpore
          <lb ed="#N" n="54"/>sub specie panis vel corpus sine anima. Septimo vtrum
          <lb ed="#N" n="55"/>christus potuit facere quod in triduo anima sua esset cum corpore in vno
          <lb ed="#N" n="56"/>loco: et non cum eodem in alio loco.
        </p>
      </div>
    </body>
