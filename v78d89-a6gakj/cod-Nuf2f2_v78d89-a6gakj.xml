    <body>
      <div xml:id="v78d89-a6gakj"><!-- q29prae -->
        <head xml:id="v78d89-a6gakj-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-a6gakj-d1e103">
          <lb ed="#N" n="59"/>⁋ Questio. xxix. de racras
          <lb ed="#N" n="60"/>mento eucharistie.
        </p>
        <p xml:id="v78d89-a6gakj-d1e110">
          <lb ed="#N" n="61"/>Oonia supra deier
          <lb ed="#N" n="62"/>minatum est de sacramento baptismi et
          confir<lb ed="#N" n="63" break="no"/>mationis: agendum est de sacramento altaris. Et
          <lb ed="#N" n="64"/>primo de prefiguratione sacramenti altaris.
          <lb ed="#N" n="65"/>Secundo de institutione. Tercio de
          vnita<lb ed="#N" n="66" break="no"/>te. Quarto de integritate. Quinto de consecratione. Sexto
          <lb ed="#N" n="67"/>de verborm expressione. Septimo de continentia. Octauo de
          <lb ed="#N" n="68"/>efficacia. Nono de fractione. Decimo de sumptione siue
          <lb ed="#N" n="69"/>manducatione.
        </p>
        <p xml:id="v78d89-a6gakj-d1e132">
          ⁋ Circa primum primo dicendum est de
          congruen<cb ed="#N" n="b"/><lb ed="#N" n="70" break="no"/>tia prefigurationis. Secundo. de numero et sufficientia
          figu<lb ed="#N" n="71" break="no"/>rarum. Tercio. de comparatione earundem.
        </p>
      </div>
    </body>
