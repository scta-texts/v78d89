    <body>
      <div xml:id="v78d89-a2rpfd"><!-- q6prae -->
        <head xml:id="v78d89-a2rpfd-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-a2rpfd-d1e103">
          <lb ed="#N" n="60"/>Quertio. vr. de
          sactame<lb ed="#N" n="61" break="no"/>tis tempore legis scripte in generali.
        </p>
        <p xml:id="v78d89-a2rpfd-d1e110">
          <lb ed="#N" n="62"/>Eterminatuest sup
          <lb ed="#N" n="63"/>de sacramentis tempore legis nature. Consequenter
          <lb ed="#N" n="64"/>dicendum est de sacramentis tempore legis scripte que
          <lb ed="#N" n="65"/>mosayca dicuntur. Primo autem dicimus
          <lb ed="#N" n="66"/>de ipsis in communi. Secundo de
          principa<lb ed="#N" n="67" break="no"/>bi scilicet circudisionenim spirtali.
        </p>
        <p xml:id="v78d89-a2rpfd-d1e126">
          ⁋ Circa Asa voiun communi. Pr
          <cb ed="#N" n="b"/>
          <lb ed="#N" n="68"/>mo querendum est de necessitate. Secundo de pluralitate et
          nu<lb ed="#N" n="69" break="no"/>meri ratione. Tercio de institutione. Quarto de efficacia.
          <lb ed="#N" n="70"/>Quinto de duratione.
        </p>
      </div>
    </body>
