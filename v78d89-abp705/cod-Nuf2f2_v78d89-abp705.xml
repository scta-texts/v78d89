      <div xml:id="v78d89-abp705"><!-- q59prae -->
        <head xml:id="v78d89-abp705-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-abp705-d1e103">
          <lb ed="#N" n="104"/>Questio. lix. de inrtitutir
          <lb ed="#N" n="105"/>one penitentie inquantum est sacramentum.
        </p>
        <p xml:id="v78d89-abp705-d1e110">
          <lb ed="#N" n="106"/>SEquitur de penite
          <lb ed="#N" n="107"/>tia inquantum est sacramentum. Et primo in
          <lb ed="#N" n="108"/>generali. Secundo in speciali scilicet de pertibus
          <lb ed="#N" n="109"/>penitentie. De primo queruntur plura.
          Pri<lb ed="#N" n="110" break="no"/>mum est de institutione. Secundum est de quid
          <lb ed="#N" n="111"/>ditate. Tercium de vnitate. Quartum de ordine.
          Quin<lb ed="#N" n="112" break="no"/>tum de iteratione. Sextum de penitentie publicatione.
        </p>
        <p xml:id="v78d89-abp705-d1e128">
          ⁋
          Cir<lb ed="#N" n="113" break="no"/>ca primum queruntur tria. Primum est an debuit institui.
          <lb ed="#N" n="114"/>Secundum quando debuit institui. Tercium a quo debuit institui.
        </p>
      </div>
    </body>
