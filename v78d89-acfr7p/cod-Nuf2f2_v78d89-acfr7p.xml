      <div xml:id="v78d89-acfr7p"><!-- q65prae -->
        <head xml:id="v78d89-acfr7p-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-acfr7p-d1e103">
          <lb ed="#N" n="121"/>Questio. ixo. de peniten
          <lb ed="#N" n="122"/>tia inquantum est sacramentum in speciali.
        </p>
        <p xml:id="v78d89-acfr7p-d1e110">
          <lb ed="#N" n="123"/>Eterminatue supra
          <lb ed="#N" n="124"/>de penitentia in generali. Consequenter
          <lb ed="#N" n="125"/>prosequendum est de penitentia in
          speciali<lb ed="#N" n="126" break="no"/>scilicet de partibus penitentie. Penitentie autem
          <lb ed="#N" n="127"/>quedam sunt partes distincte secundum diuersi
          <lb ed="#N" n="128"/>tatemm statuum. de quibus agetur primo. quedam secundum
          diuer<lb ed="#N" n="129" break="no"/>sitatem actuum de quibus secundo. Partes autem primo
          mo<lb ed="#N" n="130" break="no"/>do sumptas distinguit Ambro. sic. Triplex est modus
          pe<lb ed="#N" n="131" break="no"/>nitentie. Primus est errores et omnia mala ante baptismum
          <lb ed="#N" n="132"/>abrenunciare et condennare. Secundus post baptismum lapsas per
          <lb ed="#N" n="133"/>penitentiam reuocari. Tercius quo sancti quotidie a
          tali<lb ed="#N" n="134" break="no"/>bus peccatis purgantur sine quibus vita non agitur.
        </p>
        <p xml:id="v78d89-acfr7p-d1e139">
          ⁋ Secundum
          <lb ed="#N" n="135"/>hunc distinctionis modum. Primo tangetur de penitentia
          <lb ed="#N" n="136"/>ante baptismum. Secundo de penitentia post baptismum.
          Ter<lb ed="#N" n="137" break="no"/>cio de venialibus que accidunt in vtroque statu. Quarto
          de<lb ed="#N" n="138" break="no"/>clarantur verba apostoli vocantis ea lignum fenum et
          sti<lb ed="#N" n="139" break="no"/>pulam.
        </p>
      </div>
    </body>
