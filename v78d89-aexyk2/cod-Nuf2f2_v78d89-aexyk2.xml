      <div xml:id="v78d89-aexyk2"><!-- q81prae -->
        <head xml:id="v78d89-aexyk2-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-aexyk2-d1e103">
          <lb ed="#N" n="47"/>Questio. ixxxi de
          poterca<lb ed="#N" n="48" break="no"/>te clauium in foro iudiciali. et primo de excommunicatione
          <lb ed="#N" n="49"/>iuste lata.
        </p>
        <p xml:id="v78d89-aexyk2-d1e112">
          <lb ed="#N" n="50"/>SEquitur de poterta
          <lb ed="#N" n="51"/>te clauium in foro iudiciali. Et primo
          que<lb ed="#N" n="52" break="no"/>ritur hic de potestate excommunicandi iuste. Secundo
          <lb ed="#N" n="53"/>de excommunicatione iniusta.
        </p>
        <p xml:id="v78d89-aexyk2-d1e123">
          ⁋ Circa primum
          <lb ed="#N" n="54"/>queritur primo an ecclesia debeat excommunicare.
          <lb ed="#N" n="55"/>Secundo vtrum aliquis debeat excommunicari. Tercio supposito quod sic
          <lb ed="#N" n="56"/>pro quo sit quis excommunicandus. Quarto a quo possit fieri sententia.
          <lb ed="#N" n="57"/>Quinto vtrum excommunicatio debeat iterari. Sexto de
          communicati<lb ed="#N" n="58" break="no"/>one cum excommunicatis. Septimo de absolutione ab
          excommunica<lb ed="#N" n="59" break="no"/>tionis vinculo.
        </p>
      </div>
    </body>
