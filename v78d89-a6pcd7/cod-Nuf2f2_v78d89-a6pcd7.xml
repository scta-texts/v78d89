      <div xml:id="v78d89-a6pcd7"><!-- q31prae -->
        <head xml:id="v78d89-a6pcd7-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-a6pcd7-d1e103">
          <lb ed="#N" n="34"/>⁋ Questio. xxxi de vnitate
          <lb ed="#N" n="35"/>sacramenti eucharistie.
        </p>
        <p xml:id="v78d89-a6pcd7-d1e110">
          <lb ed="#N" n="36"/>Equmiturde vnitate
          <lb ed="#N" n="37"/>huius sacramenti. Circa hoc queruntur tria.
          <lb ed="#N" n="38"/>Primum est vtrum hoc sacramentum sit
          <lb ed="#N" n="39"/>vnum. Secundum supposito quod sit vnum. qua
          <lb ed="#N" n="40"/>re sub duplici specie conficiatur. Tercium
          <lb ed="#N" n="41"/>vtrum verius dicendum est species panis et vini esse
          sacramen<lb ed="#N" n="42" break="no"/>tum an contentum sub speciebus.
        </p>
      </div>
    </body>
