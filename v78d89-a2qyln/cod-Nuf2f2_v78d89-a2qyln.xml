    <body>
      <div xml:id="v78d89-a2qyln"><!-- q4prae -->
        <head xml:id="v78d89-a2qyln-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-a2qyln-d1e103">
          <lb ed="#N" n="50"/>⁋ Questio. viii. de iisms
          <lb ed="#N" n="51"/>fine ecclesie.
        </p>
        <p xml:id="v78d89-a2qyln-d1e110">
          <lb ed="#N" n="52"/>Omeduenter
          Oro<lb ed="#N" n="53" break="no"/>cedendum est ad quartam quosionem scilicet de initio
          <lb ed="#N" n="54"/>vccle et fine ecclesie. Et queruntur tria. Primo
          <lb ed="#N" n="55"/>quo tempore incepit ecclesia. vtrum ab adam vel ab
          <lb ed="#N" n="56"/>abel vel ab alio principio. Secundo cum abel
          <lb ed="#N" n="57"/>estet principium ecclesie fidelium et vt membrum ipsius corporis ecclesie
          <lb ed="#N" n="58"/>vtrum tunc corpus ecclesie esset acephalum an haberet caput suum.
          Ter<lb ed="#N" n="59" break="no"/>cio occasione predictorum queritur de duratione ecclesie.
        </p>
      </div>
