      <div xml:id="v78d89-a7j236"><!-- q36prae -->
        <head xml:id="v78d89-a7j236-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-a7j236-d1e103">
          <lb ed="#N" n="67"/>⁋ Quescio. xxxvi. de
          conse<lb ed="#N" n="68" break="no"/>crationis vsu.
        </p>
        <p xml:id="v78d89-a7j236-d1e110">
          <cb ed="#N" n="b"/>
          <lb ed="#N" n="69"/>SEquitur de conses
          <lb ed="#N" n="70"/>cratione quantum ad vsum. Circa hoc
          proce<lb ed="#N" n="71" break="no"/>ditur sic. Primo de loco consecrationis.
          <lb ed="#N" n="72"/>Secundo de tempore. Tercio de altari
          su<lb ed="#N" n="73" break="no"/>per quod consecrandum est. Quarto de
          pan<lb ed="#N" n="74" break="no"/>nis. Quntio de calice et patena. Sexto de indumentis
          con<lb ed="#N" n="75" break="no"/>secrantis. Septimc de multitudine assistentium. Octauo de
          <lb ed="#N" n="76"/>multitudine consecrantium. Nono de necessitate verborum
          di<lb ed="#N" n="77" break="no"/>cendorum in consecratione. Decimo de ratione et intellectu
          eo<lb ed="#N" n="78" break="no"/>rum que adduntur ad laudem dei et sacramenti
          solennita<lb ed="#N" n="79" break="no"/>tem.
        </p>
      </div>
    </body>
