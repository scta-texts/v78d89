    <body>
      <div xml:id="v78d89-a3zpyr"><!-- q16prae -->
        <head xml:id="v78d89-a3zpyr-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-a3zpyr-d1e103">
          <lb ed="#N" n="98"/>⁋ Questio. xvi. de conditio
          <lb ed="#N" n="99"/>nibus baptizantis.
        </p>
        <p xml:id="v78d89-a3zpyr-d1e110">
          <lb ed="#N" n="100"/>SEquitur de condito
          <lb ed="#N" n="101"/>nibus baptizantis. vbi primo queritur vtrum
          <lb ed="#N" n="102"/>soli sacerdotes posunt baptizare. Secundo vtrum
          <lb ed="#N" n="103"/>mali posunt baptizare. Tercio vtrum
          heretici<lb ed="#N" n="104" break="no"/>posunt baptizare. Quarto vtrum demones. Qum
          <lb ed="#N" n="105"/>to vtrum carentes rationis vsu. Sexto vtrum plures persone posunt
          ba<lb ed="#N" n="106" break="no"/>ptizare vnam. Septimo vtrum vna persona possit simul baptiza
          <lb ed="#N" n="107"/>re plures. Octauo vtrum aliquis potest baptizare seipsum.
        </p>
      </div>
