      <div xml:id="v78d89-affrec"><!-- q84prae -->
        <head xml:id="v78d89-affrec-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-affrec-d1e103">
          <pb ed="#N" n="539"/>
          <cb ed="#N" n="a"/>
          <lb ed="#N" n="1"/>⁋ Questio. ixxxiiii. de nati
          <lb ed="#N" n="2"/>factione in generali.
        </p>
        <p xml:id="v78d89-affrec-d1e114">
          <lb ed="#N" n="3"/>Scto de duabpas
          <lb ed="#N" n="4"/>vbus penitentie scilicet contritione et confessione: sequitur
          <lb ed="#N" n="5"/>tercia pars scilicet de satisfactione. Circa quam
          <lb ed="#N" n="6"/>sic proceditur. Primo agitur de satisfactione
          <lb ed="#N" n="7"/>in communi. Secundo in speciali. scilicet de perti
          <lb ed="#N" n="8"/>bus illius scilicet oratione. ieiunio. et elemosina.
        </p>
        <p xml:id="v78d89-affrec-d1e130">
          ⁋ In primo pro
          <lb ed="#N" n="9"/>ceditur sic. Primo agitur de satisfactionis possibilitate. Secundo
          <lb ed="#N" n="10"/>de necessitate. Tercio de quiditate. Quarto de
          fructuosi<lb ed="#N" n="11" break="no"/>tate. Quinto de ablatorum restitutione.
        </p>
      </div>
    </body>
