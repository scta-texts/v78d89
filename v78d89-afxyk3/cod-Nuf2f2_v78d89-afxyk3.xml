      <div xml:id="v78d89-afxyk3"><!-- q88prae -->
        <head xml:id="v78d89-afxyk3-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-afxyk3-d1e103">
          <lb ed="#N" n="105"/>Luertio. txxxvtii. de bratoe
          <lb ed="#N" n="106"/>in generali.
        </p>
        <p xml:id="v78d89-afxyk3-d1e110">
          <lb ed="#N" n="107"/>Ecso de diulrose
          <lb ed="#N" n="108"/>satisfactionis et de prerogatiua efficacie
          ipsa<lb ed="#N" n="109" break="no"/>rum pertium: dicendum est sigillatim de ipsis partibus.
          <lb ed="#N" n="110"/>Et primo de oratioe que magis proprie ordinat ad
          <lb ed="#N" n="111"/>deum. et consqenter de aliis. Primo ergo queritur de
          <lb ed="#N" n="112"/>oratione generaliter scilicet quid sit. Secundo spiretialius de pertibus illius. Ter
          <lb ed="#N" n="113"/>cio de vsu eius. Quarto de eius efficacia.
        </p>
        <p xml:id="v78d89-afxyk3-d1e128">
          ⁋ Circa prima partem
          <lb ed="#N" n="114"/>queritur. Primo quid sit oratio secundum diffinitionem. Secundo
          <lb ed="#N" n="115"/>quid sit secundum rem.
        </p>
      </div>
    </body>
