      <div xml:id="v78d89-a56spt"><!-- q21prae -->
        <head xml:id="v78d89-a56spt-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-a56spt-d1e103">
          <lb ed="#N" n="31"/>Questio. xxi. de effectum
          <lb ed="#N" n="32"/>baptismi quantum ad collationem boni.
        </p>
        <p xml:id="v78d89-a56spt-d1e110">
          <lb ed="#N" n="33"/>Icto de effectum
          <lb ed="#N" n="34"/>aptismi. Consequenter queritur de effectu
          <lb ed="#N" n="35"/>qui determinatur quantum ad collationem boni.
          <lb ed="#N" n="36"/>Circa quod primo queritur. Utrum paruulis in
          ba<lb ed="#N" n="37" break="no"/>ptismo conferantur gratie et virtutes.
          Se<lb ed="#N" n="38" break="no"/>cundo queritur vtrum augeantur in adultis iam per fidem
          iustifica<lb ed="#N" n="39" break="no"/>tis. Tercio vtrum equaliter detur gratia omnibus baptisatis
          <lb ed="#N" n="40"/>Quarto vtrum illuinatio conferatur in baptismo. Quinto vtrum
          <lb ed="#N" n="41"/>fecundatio. Sexto vtrum tncorparatio. Septimo vtrum ianue
          <lb ed="#N" n="42"/>apertio.
        </p>
      </div>
    </body>
