    <body>
      <div xml:id="v78d89-aajyau"><!-- q52prae -->
        <head xml:id="v78d89-aajyau-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-aajyau-d1e103">
          <lb ed="#N" n="46"/>⁋ Quertio. ii. de actumandu
          <lb ed="#N" n="47"/>candi in comparatione ad manducantem.
        </p>
        <p xml:id="v78d89-aajyau-d1e110">
          <lb ed="#N" n="48"/>SEquitur de actu
          <lb ed="#N" n="49"/>manducandi in comparatione ad manducantem
          <lb ed="#N" n="50"/>Et primo queritur vtrum ieiuno stomacho
          <lb ed="#N" n="51"/>debeat quis corpus christi sumere. Eecundo vtrum
          <lb ed="#N" n="52"/>liceat statim post sumptionem corporis christi
          su<lb ed="#N" n="53" break="no"/>mere ribum corporalem. Tercio vtrum liceat in vno die
          pluri<lb ed="#N" n="54" break="no"/>es sumere. Quarto vtrum gustu tantum autm etiam alio sensu
          su<lb ed="#N" n="55" break="no"/>matur. Quinto vtrum peccator peccet nidendo corpus christi.
          Se<lb ed="#N" n="56" break="no"/>xto vtrum liceat in aliquo casu peccatorem tangere corpus christi.
        </p>
      </div>
    </body>
