      <div xml:id="v78d89-ai8k1w"><!-- q107prae -->
        <head xml:id="v78d89-ai8k1w-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-ai8k1w-d1e103">
          <lb ed="#N" n="139"/>⁋ Questio. cvii. de
          medica<lb ed="#N" n="140" break="no"/>tione pauperum voluntariorum.
        </p>
        <p xml:id="v78d89-ai8k1w-d1e110">
          <pb ed="#N" n="666"/>
          <cb ed="#N" n="a"/>
          <lb ed="#N" n="1"/>SEquitur de medica
          <lb ed="#N" n="2"/>tione eorum qui omnia sua dederunt pauperibus.
          <lb ed="#N" n="3"/>Primo ergo queritur vtrum licitum sit talibus
          mendica<lb ed="#N" n="4" break="no"/>re. Secundo vtrum sit meritorium. Terco vtrum sit
          <lb ed="#N" n="5"/>magis meritorium omnia sua pauperibus dare et
          <lb ed="#N" n="6"/>victum suum mendicare: quam sua retinere ad suam sustentationem et
          pau<lb ed="#N" n="7" break="no"/>perum subuentionem. Quarto quia non sufficit veritatem circa illa
          <lb ed="#N" n="8"/>que intenduntur diffinire sed falsitatem aduersantium de qua
          po<lb ed="#N" n="9" break="no"/>nentur rationes ad repellendum ea que falso vel erronee
          ob<lb ed="#N" n="10" break="no"/>uiandum predictis inducta sunt.
        </p>
      </div>
    </body>
