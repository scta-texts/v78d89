      <div xml:id="v78d89-aj3g71"><!-- q113prae -->
        <head xml:id="v78d89-aj3g71-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-aj3g71-d1e103">
          <lb ed="#N" n="97"/>Questo. cxtii. de necefitate
          <lb ed="#N" n="98"/>distribuendi elemosynas.
        </p>
        <p xml:id="v78d89-aj3g71-d1e110">
          <lb ed="#N" n="99"/>Onsequeter
          quer<lb ed="#N" n="100" break="no"/>tur de necessitate distribuendi elemosynas. Et
          <lb ed="#N" n="101"/>primo queritur. vtrum ille qui potest: necessario teneatur
          <lb ed="#N" n="102"/>facere elemosnam indigenti circa vltimam necessitatem.
          <lb ed="#N" n="103"/>Secundo vtrum magis teneatur dare propinquo in
          <lb ed="#N" n="104"/>fideli quam extraneo fideli. Tercio vtrum necessario teneatur
          fa<lb ed="#N" n="105" break="no"/>cere illi qui est in extrema necessitate.
        </p>
      </div>
    </body>
