        <head xml:id="v78d89-a8jb6a-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-a8jb6a-d1e103">
          <lb ed="#N" n="6"/>Questio. xiii. ds rractioue
          <lb ed="#N" n="7"/>hostie.
        </p>
        <p xml:id="v78d89-a8jb6a-d1e110">
          <lb ed="#N" n="8"/>SEquitur de rractoe
          <lb ed="#N" n="9"/>hostie que est nona pars huius tractatus.
          <lb ed="#N" n="10"/>Circa hoc primo queritur de fractione
          con<lb ed="#N" n="11" break="no"/>tenti. Secundo de fractione continentis.
          <lb ed="#N" n="12"/>Tercio de partium fractarum
          idempti<lb ed="#N" n="13" break="no"/>tate. Quarto de partium significatione. Quinto de partium
        </p>
        <p xml:id="v78d89-a8jb6a-d1e126">
          <lb ed="#N" n="14"/>repletione.
        </p>
      </div>
