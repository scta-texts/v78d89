      <div xml:id="v78d89-a71r0y"><!-- q33prae -->
        <head xml:id="v78d89-a71r0y-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-a71r0y-d1e103">
          <lb ed="#N" n="47"/>⁋ Quertio. xxxiii. de
          inte<lb ed="#N" n="48" break="no"/>gritate eucharistie respectu forme.
        </p>
        <p xml:id="v78d89-a71r0y-d1e110">
          <lb ed="#N" n="49"/>SEquitur de inteert
          <lb ed="#N" n="50"/>tate huius sacramenti quantum ad ea que sunt ex
          <lb ed="#N" n="51"/>parte forme: que attenditur in verbis
          prola<lb ed="#N" n="52" break="no"/>stis in consecratione ipsius. Circa que queruntur
          <lb ed="#N" n="53"/>quatuor. Primum est de forma verborum
          <lb ed="#N" n="54"/>quantum ad ipsa verbam in transsubstntiatione panis. Que sit
          for<lb ed="#N" n="55" break="no"/>ma prescripta sub qua conficit ecclesia. Secundum. vtrum sub
          illa<lb ed="#N" n="56" break="no"/>forma dominus confecerit. Tercium. de dubitabilibus incidentibus
          <lb ed="#N" n="57"/>circa formam prescriptam. Quarto. de forma verborum que est
          <lb ed="#N" n="58"/>in transsubstantiatione vini.
        </p>
      </div>
    </body>
