      <div xml:id="v78d89-adh8li"><!-- q72prae -->
        <head xml:id="v78d89-adh8li-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-adh8li-d1e103">
          <lb ed="#N" n="16"/>Questio. ixxii. de sumes
          <lb ed="#N" n="17"/>ro et sufficientia eorum que requiruntur ad iustificationem.
        </p>
        <p xml:id="v78d89-adh8li-d1e110">
          <lb ed="#N" n="18"/>SEquitur de numss
          <lb ed="#N" n="19"/>ro eorum et sufficientia que requiruntur ad
          iu<lb ed="#N" n="20" break="no"/>stificationem impii. Circa quod queruntur
          plura<lb ed="#N" n="21" break="no"/>Primo vtrum cum contritione requiratur infusio
          <lb ed="#N" n="22"/>gratie. Secundo vtrum cum hoc requiratur
          <lb ed="#N" n="23"/>vniuersalis expulsio culpe. Tercio vtrum cum his
          requira<lb ed="#N" n="24" break="no"/>tur motus libro. arbto. Quarto de numero eorum que requiruntur.
        </p>
      </div>
