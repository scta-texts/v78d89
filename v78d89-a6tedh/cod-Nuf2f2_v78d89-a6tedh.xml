    <body>
      <div xml:id="v78d89-a6tedh"><!-- q32prae -->
        <head xml:id="v78d89-a6tedh-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-a6tedh-d1e103">
          <lb ed="#N" n="130"/>Quertio. xxxii. de inteiert
          <lb ed="#N" n="131"/>tate sacramenti eucharistie respectu materie.
        </p>
        <p xml:id="v78d89-a6tedh-d1e110">
          <lb ed="#N" n="132"/>SEquitur de intecrt
          <lb ed="#N" n="133"/>tate huius sacramenti. Et primo queritur de his que
          <lb ed="#N" n="134"/>sunt ex parte materie. Secundo de his que
          <lb ed="#N" n="135"/>sunt ex parte forme.
        </p>
        <p xml:id="v78d89-a6tedh-d1e121">
          ⁋ Circa ea que
          respi<lb ed="#N" n="136" break="no"/>ciunt materiam queruntur nouem.
          Pri<lb ed="#N" n="137" break="no"/>mum est vtrum debeat confici de materia panis et vini.
          <lb ed="#N" n="138"/>Secundum vtrum ex pane triticeo. Tercium vtrum ex amimo
          <lb ed="#N" n="139"/>et fermentato. Quartum vtrum ex omni genere panis.
          Quin<pb ed="#N" n="191"/><cb ed="#N" n="a"/><lb ed="#N" n="1" break="no"/>tum vtrum aqua est admiscenda vino. Sextum vtrum sanguis
          si<lb ed="#N" n="2" break="no"/>ne aqua possit consecrari. Septimum vtrum possit confici ex omni
          ge<lb ed="#N" n="3" break="no"/>neri vini. Octauum vtrum ex aceto. Nonum vtrum ex omni liquore
          <lb ed="#N" n="4"/>qui prcedit ex vua. vtpote de agresta et musto dulci.
        </p>
      </div>
    </body>
