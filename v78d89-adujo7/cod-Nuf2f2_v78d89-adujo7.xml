      <div xml:id="v78d89-adujo7"><!-- q75prae -->
        <head xml:id="v78d89-adujo7-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-adujo7-d1e103">
          <lb ed="#N" n="24"/>Qaestio. ixxo. de orimiint
          <lb ed="#N" n="25"/>contritionis.
        </p>
        <p xml:id="v78d89-adujo7-d1e110">
          <lb ed="#N" n="26"/>SEquitur de vriucine
          <lb ed="#N" n="27"/>contritionis: de quo queruntur plura. Primum est
          <lb ed="#N" n="28"/>vtrum sit donum spiritus sancti. Secundum vtrum sit
          <lb ed="#N" n="29"/>motus alicuius virtutis. Tercium vtrum sit
          <lb ed="#N" n="30"/>motus virtutis generalis vel specialis.
          <lb ed="#N" n="31"/>Quartum vtrum sit motus virtutis theologice vel cardinalis.
          <lb ed="#N" n="32"/>Quintum vtrum possit impleri in via a penitentibus.
        </p>
      </div>
    </body>
