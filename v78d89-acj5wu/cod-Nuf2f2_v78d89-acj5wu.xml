    <body>
      <div xml:id="v78d89-acj5wu"><!-- q66prae -->
        <head xml:id="v78d89-acj5wu-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-acj5wu-d1e103">
          <lb ed="#N" n="131"/>Questio. txor. de vtious
          <lb ed="#N" n="132"/>penitentie inquantum sacramentum in generali.
        </p>
        <p xml:id="v78d89-acj5wu-d1e110">
          <lb ed="#N" n="133"/>Ectum est de parti
          <lb ed="#N" n="134"/>bus penitentie distinctis secundum diuersitatem
          sta<lb ed="#N" n="135" break="no"/>tuum: restat dicere de illis que distinguuntur
          <lb ed="#N" n="136"/>secundum diuersitatem actuum. Iste autem sunt tres
          <lb ed="#N" n="137"/>contritio confessio et satisfactio. De his queritur
          <lb ed="#N" n="138"/>primo in generali: secundo in speciali.
        </p>
        <p xml:id="v78d89-acj5wu-d1e126">
          ⁋ Circa primun querurter
          <lb ed="#N" n="139"/>duo. Primum est. cuius sunt partes. Secundum cuius modi sunt partes.
        </p>
      </div>
    </body>
