      <div xml:id="v78d89-aaslth"><!-- q53prae -->
        <head xml:id="v78d89-aaslth-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-aaslth-d1e103">
          <lb ed="#N" n="86"/>Questio iiii. de actum man
          <lb ed="#N" n="87"/>ducandi in comparatione ad manducatum.
        </p>
        <p xml:id="v78d89-aaslth-d1e110">
          <lb ed="#N" n="88"/>COnsequenter
          que<lb ed="#N" n="89" break="no"/>ritur de actu manducandi in
          compara<lb ed="#N" n="90" break="no"/>tione ad manducatum. Primo
          queri<lb ed="#N" n="91" break="no"/>tur vtrum liceat sumere corpus christi sub
          spe<lb ed="#N" n="92" break="no"/>cie panis tantum: sine sumptione sub specie vini.
          <lb ed="#N" n="93"/>Secundo vtrum corpus christi sumptum intret ventrem. Tercio
          <lb ed="#N" n="94"/>vtrum eiiciatur per vomitum. Quarto vtrum sub propria specie scilicet
          <lb ed="#N" n="95"/>carnis sit sumendum. Quinto de reditione specie panis post
          <lb ed="#N" n="96"/>corpus sumptum.
        </p>
      </div>
    </body>
