    <body>
      <div xml:id="v78d89-ade6d3"><!-- q71prae -->
        <head xml:id="v78d89-ade6d3-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-ade6d3-d1e103">
          <lb ed="#N" n="137"/>⁋ Questio. ixxi. deessectu
          <lb ed="#N" n="138"/>contritionis qui est purgatio reliquiarum peccati.
        </p>
        <p xml:id="v78d89-ade6d3-d1e110">
          <pb ed="#N" n="459"/>
          <cb ed="#N" n="a"/>
          <lb ed="#N" n="1"/>SEquitur de erfectum
          <lb ed="#N" n="2"/>contritionis quantum ad purgationem reliquiarum
          <lb ed="#N" n="3"/>peccati. Purgata enim anima per gratiam a culpa.
          <lb ed="#N" n="4"/>quedam reliquie peccati remanent. scilicet
          <lb ed="#N" n="5"/>obtenebratioens. sordide affectiones.
          <lb ed="#N" n="6"/>relicte ex operibus peccati. ex quibus sapor supernorum
          <lb ed="#N" n="7"/>et desiderium tepescit: et infirmitas qua prona fit aneinma
          <lb ed="#N" n="8"/>ad malum et difficilis ad bonum.
        </p>
        <p xml:id="v78d89-ade6d3-d1e134">
          ⁋ Queritur ergo hic primo de
          <lb ed="#N" n="9"/>effectu illuminationis siue extersionis tenebrositatis. Secum
          <lb ed="#N" n="10"/>do de effectu lauationis sordidu affectus. Tercio de effectu
          <lb ed="#N" n="11"/>sanationis infirmitatis.
        </p>
      </div>
    </body>
