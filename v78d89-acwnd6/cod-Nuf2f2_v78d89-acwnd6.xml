      <div xml:id="v78d89-acwnd6"><!-- q69prae -->
        <head xml:id="v78d89-acwnd6-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-acwnd6-d1e103">
          <lb ed="#N" n="38"/>⁋ Questio. ixix. de
          contri<lb ed="#N" n="39" break="no"/>tionis obiecto.
        </p>
        <p xml:id="v78d89-acwnd6-d1e110">
          <lb ed="#N" n="40"/>SEquitur de
          cotriti<lb ed="#N" n="41" break="no"/>one quantum ad obiectum. de quo queruntur hec.
          <lb ed="#N" n="42"/>Primo. vtrum contritio debeat esse de peccato
          <lb ed="#N" n="43"/>commisso. Secundo. vtrum debeat esse de peccatis
          <lb ed="#N" n="44"/>et penis peccatorum. Terco. vtrum debeat esse
          <lb ed="#N" n="45"/>de difformitate et de actu. Quarto. vtrum de originali sicut
          <lb ed="#N" n="46"/>de actuali. Quinto. vtrum requiritur contritio de veniali sicut de
          <lb ed="#N" n="47"/>actuali mortali. Sexto. vtrum de peccato quod comittitur ex
          tri<lb ed="#N" n="48" break="no"/>sticia. Septimo. vtrum de peccato quod comittitur per ignorantiam.
          <lb ed="#N" n="49"/>Octauo. vtrum de peccato oblito. Nono. vtrum de peccato
          futu<lb ed="#N" n="50" break="no"/>ro. Decimo. si contritio possit esse de vno solo.
        </p>
      </div>
