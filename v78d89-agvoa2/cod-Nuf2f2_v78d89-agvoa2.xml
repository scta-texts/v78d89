      <div xml:id="v78d89-agvoa2"><!-- q96prae -->
        <head xml:id="v78d89-agvoa2-Hd1e101">Praeambulum</head>
        <p xml:id="v78d89-agvoa2-d1e103">
          <lb ed="#N" n="121"/>Iruertio. xcvi de erficacia
          <lb ed="#N" n="122"/>orationis.
        </p>
        <p xml:id="v78d89-agvoa2-d1e110">
          <lb ed="#N" n="123"/>SEquitur de
          erfica<lb ed="#N" n="124" break="no"/>cia orationis. Primo ergo queritur vtrum efficax sit
          <lb ed="#N" n="125"/>ex puris naturalibus. siue ex gratia
          gratisda<lb ed="#N" n="126" break="no"/>ta: siue gratum faciente. Secundo modo vtrum oratio
          ra<lb ed="#N" n="127" break="no"/>tionabilis sit efficax ad impetrandum.
          Ter<lb ed="#N" n="128" break="no"/>cio queritur de conditionibus quibus efficitur efficax ad impetrandum.
          <lb ed="#N" n="129"/>Quarto que ritur de efficacia orationis ad satisfaciendum. Quinto
          <lb ed="#N" n="130"/>queritur de efficacia orationis pauli.
        </p>
      </div>
